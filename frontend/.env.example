# ====================================================================
# Polymind Frontend — Environment Variables
# ====================================================================
# Copy to .env.local for local dev, and set these in Vercel for production.

# Backend API base URL (Railway URL in production)
# Example: https://polymind-api.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base (usually same host, ws:// or wss://)
# Example: wss://polymind-api.up.railway.app
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Google OAuth client id (for "Continue with Google")
# Get from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Twitter URL — leave blank if you don't have one yet, footer will hide the link
NEXT_PUBLIC_TWITTER_URL=

# Toggle: show Phantom wallet auth button
NEXT_PUBLIC_PHANTOM_ENABLED=true
